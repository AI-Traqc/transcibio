# --- Diarization (optional, pyannote) ---
# Hugging Face token — required only when diarization is enabled.
# Accept model terms at: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
# Optional: force CUDA startup (diarizer fails fast if GPU/CUDA is unavailable)
# FORCE_GPU=true
# Optional: pin device used by the pyannote diarizer (e.g. cpu, cuda, cuda:0)
# TRANSCIBIO_DIARIZATION_DEVICE=

# --- Local LLM (chat + transcript correction) ---
# The defaults below suit a laptop (16-32 GB RAM). With 32+ GB of GPU memory, set the
# larger values by hand:
# TRANSCIBIO_OLLAMA_MODEL=gemma4:26b, TRANSCIBIO_OLLAMA_NUM_CTX=131072, TRANSCIBIO_PROFILE=quality
TRANSCIBIO_LLM_PROVIDER=ollama
# Chat model; must be installed in Ollama (`ollama pull <model>`, check with `ollama list`).
TRANSCIBIO_OLLAMA_MODEL=gemma4:e4b
# Optional Ollama chat endpoint override
# TRANSCIBIO_OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
# Default for the Settings "Thinking mode" switch (typed chat + transcript correction).
# Off = faster answers; true = the model's default. The switch in Settings wins once saved.
# Voice turns and titles never reason.
TRANSCIBIO_OLLAMA_THINK=false
# Context window (tokens) for every Ollama call; summaries send the whole transcript up to
# this size (32768: about 30-60 min of meeting, 131072: 3-5 h). More needs more memory.
# Minimum 16384; without this line the app uses 131072.
TRANSCIBIO_OLLAMA_NUM_CTX=32768
# Optional timeout for transcript correction requests
# TRANSCIBIO_OLLAMA_CORRECTION_TIMEOUT_SECONDS=180
# Optional legacy generate endpoint; transcript correction derives /api/chat from this when possible
# TRANSCIBIO_OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate

# --- Voice mode / TTS engines (optional) ---
# Streaming voice-mode engines. Defaults live under data/, so only set these
# when models/binaries are stored elsewhere. The active engine (Piper for
# German / Kokoro for English) is chosen at runtime in app Settings via the
# persisted tts.voice_engine setting — it is NOT an env var.
# Piper (German):
# TRANSCIBIO_PIPER_BIN=data/bin/piper/piper.exe
# TRANSCIBIO_PIPER_MODEL=data/models/tts/piper/de_DE-thorsten-high.onnx
# Kokoro (English):
# TRANSCIBIO_KOKORO_MODEL=data/models/tts/kokoro/kokoro-v1.0.onnx
# TRANSCIBIO_KOKORO_VOICES=data/models/tts/kokoro/voices-v1.0.bin
# TRANSCIBIO_KOKORO_VOICE=af_sarah

# --- Providers / profile ---
# TRANSCIBIO_STT_PROVIDER=faster-whisper
# faster-whisper device: auto (default) = cuda when CTranslate2 sees a GPU, else cpu.
# Compute type defaults to float16 on cuda and int8 on cpu.
# TRANSCIBIO_STT_DEVICE=auto          # auto | cuda | cpu
# TRANSCIBIO_STT_COMPUTE_TYPE=        # e.g. float16, int8_float16, int8
# TRANSCIBIO_TTS_PROVIDER=piper
# Starting Whisper model until one is saved in Settings:
# fast (small) | balanced (medium, default) | quality (large-v3)
# TRANSCIBIO_PROFILE=balanced

# --- Optional second transcription engine: Nemotron 3.5 Transcribe ---
# Selected per install in Settings ("Transcription engine"); Whisper + pyannote stays default.
# Start its vLLM server with the compose profile (no launcher flag needed):
# COMPOSE_PROFILES=nemotron
# TRANSCIBIO_NEMOTRON_URL=http://127.0.0.1:8010/v1/chat/completions
# TRANSCIBIO_NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4
# TRANSCIBIO_NEMOTRON_TIMEOUT_SECONDS=1800

# --- Paths and API binding ---
# TRANSCIBIO_DATA_ROOT=data
# TRANSCIBIO_DB_PATH=data/privata.db
# TRANSCIBIO_SESSIONS_ROOT=data/sessions
# TRANSCIBIO_API_HOST=127.0.0.1
# TRANSCIBIO_API_PORT=8000
# Hostnames the API answers to and accepts browser requests from. localhost, 127.0.0.1
# and ::1 are always allowed; add more only to open the app by another name or IP
# (comma-separated). Blocks DNS rebinding and cross-site requests (no auth on the API).
# TRANSCIBIO_ALLOWED_HOSTS=myhost.local,192.168.1.50

# --- Startup checks ---
# TRANSCIBIO_REQUIRE_FFMPEG=false   # set true to fail startup when ffmpeg/ffprobe are missing
