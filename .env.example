# --- Diarization (optional, pyannote) ---
# Hugging Face token — required only when diarization is enabled.
# Accept model terms at: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=
# Optional: force CUDA startup (diarizer fails fast if GPU/CUDA is unavailable)
# FORCE_GPU=true
# Optional: pin device used by the pyannote diarizer (e.g. cpu, cuda, cuda:0)
# TRANSCIBIO_DIARIZATION_DEVICE=

# --- Local LLM (chat + transcript correction) ---
TRANSCIBIO_LLM_PROVIDER=ollama
# Optional Ollama model override
TRANSCIBIO_OLLAMA_MODEL=gpt-oss-20b
# Optional Ollama chat endpoint override
# TRANSCIBIO_OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
# Optional timeout for transcript correction requests
# TRANSCIBIO_OLLAMA_CORRECTION_TIMEOUT_SECONDS=180
# Optional legacy generate endpoint; transcript correction derives /api/chat from this when possible
# TRANSCIBIO_OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate

# --- Voice mode / TTS engines (optional) ---
# Streaming voice-mode engines. Defaults live under data/, so only set these
# when models/binaries are stored elsewhere. The active engine (Piper for
# German / Kokoro for English) is chosen at runtime in app Settings via the
# persisted tts.voice_engine setting — it is NOT an env var.
# Piper (German):
# TRANSCIBIO_PIPER_BIN=data/bin/piper/piper.exe
# TRANSCIBIO_PIPER_MODEL=data/models/tts/piper/de_DE-thorsten-high.onnx
# Kokoro (English):
# TRANSCIBIO_KOKORO_MODEL=data/models/tts/kokoro/kokoro-v1.0.onnx
# TRANSCIBIO_KOKORO_VOICES=data/models/tts/kokoro/voices-v1.0.bin
# TRANSCIBIO_KOKORO_VOICE=af_sarah

# --- Providers / profile ---
# TRANSCIBIO_STT_PROVIDER=faster-whisper
# TRANSCIBIO_TTS_PROVIDER=piper
# TRANSCIBIO_PROFILE=balanced   # fast | balanced | quality

# --- Paths and API binding ---
# TRANSCIBIO_DATA_ROOT=data
# TRANSCIBIO_DB_PATH=data/privata.db
# TRANSCIBIO_SESSIONS_ROOT=data/sessions
# TRANSCIBIO_API_HOST=127.0.0.1
# TRANSCIBIO_API_PORT=8000

# --- Startup checks ---
# TRANSCIBIO_REQUIRE_FFMPEG=false   # set true to fail startup when ffmpeg/ffprobe are missing
